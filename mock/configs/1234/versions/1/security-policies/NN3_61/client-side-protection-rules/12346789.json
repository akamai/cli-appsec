{
  "responseToChoose": 0,
  "responses": [
    {
      "httpStatus": 200,
      "response": {
        "ruleId": 12346789,
        "ruleName": "Block PCI Data Access from Third Parties",
        "ruleDescription": "Prevents third-party scripts from accessing payment card data",
        "activityType": "DATA_ACCESS",
        "conditions": {
          "page": {
            "condition": "MATCHES",
            "values": ["/checkout", "/billing/*"]
          },
          "script": {
            "scriptType": "THIRD_PARTY",
            "condition": "MATCHES",
            "values": ["analytics.example.com/*"]
          },
          "activityTypeValues": {
            "condition": "MATCHES",
            "values": ["CREDIT_CARD", "PII"]
          }
        },
        "action": "deny"
      }
    }
  ]
}
